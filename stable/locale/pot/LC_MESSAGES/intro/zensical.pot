#: ../../../intro/zensical.rst:7
msgid ""
"Zensical_ is a static site generator for project documentation, built by the "
"creators of Material for MkDocs."
msgstr ""

#: ../../../intro/zensical.rst:10
msgid ""
"Read the Docs builds your Zensical site on every push, previews your pull "
"requests, and hosts every version of your documentation."
msgstr ""

#: ../../../intro/zensical.rst:14
msgid ""
"Minimal configuration is required to build an existing Zensical project on "
"Read the Docs:"
msgstr ""

#: ../../../intro/zensical.rst:16
msgid ".readthedocs.yaml"
msgstr ""

#: ../../../intro/zensical.rst:16
msgid ""
" version: 2\n"
"\n"
" build:\n"
"   os: ubuntu-24.04\n"
"   tools:\n"
"     python: latest\n"
"   jobs:\n"
"     # For reproducible builds, install with uv:\n"
"     # https://docs.readthedocs.com/platform/stable/build-customization."
"html#install-dependencies-with-uv\n"
"     install:\n"
"       - pip install zensical\n"
"     build:\n"
"       html:\n"
"         - zensical build\n"
"     post_build:\n"
"       # Copy the built site into the directory Read the Docs publishes.\n"
"       - mkdir -p $READTHEDOCS_OUTPUT/html/\n"
"       - cp --recursive site/* $READTHEDOCS_OUTPUT/html/"
msgstr ""

