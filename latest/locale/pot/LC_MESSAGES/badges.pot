#: ../../../badges.rst:62
msgid "Version-specific badges"
msgstr ""

#: ../../../badges.rst:64
msgid ""
"You can change the version of the documentation your badge points to. To do "
"this, you can pass the ``version`` GET argument to the badge URL. By "
"default, it will point at the *default version* you have specified for your "
"project."
msgstr ""

#: ../../../badges.rst:68
msgid "The badge URL looks like this:"
msgstr ""

#: ../../../badges.rst:70
msgid ""
"https://app.readthedocs.org/projects/<project-slug>/badge/?version=latest"
msgstr ""

#: ../../../badges.rst:76
msgid "Embedding a badge"
msgstr ""

#: ../../../badges.rst:78
msgid ""
"Use one of the following snippets to embed a badge in your README or "
"documentation pages. Replace ``<project-slug>`` with your project's slug, "
"and ``<project-url>`` with the URL of your documentation."
msgstr ""

#: ../../../badges.rst:84
msgid "reStructuredText"
msgstr ""

#: ../../../badges.rst:86
msgid ""
".. image:: https://app.readthedocs.org/projects/<project-slug>/badge/?"
"version=latest\n"
"   :target: <project-url>\n"
"   :alt: Documentation Status"
msgstr ""

#: ../../../badges.rst:92
msgid "Markdown"
msgstr ""

#: ../../../badges.rst:94
msgid ""
"[![Documentation Status](https://app.readthedocs.org/projects/<project-slug>/"
"badge/?version=latest)](<project-url>)"
msgstr ""

#: ../../../badges.rst:98
msgid "HTML"
msgstr ""

#: ../../../badges.rst:100
msgid ""
"<a href=\"<project-url>\">\n"
"  <img src=\"https://app.readthedocs.org/projects/<project-slug>/badge/?"
"version=latest\" alt=\"Documentation Status\" />\n"
"</a>"
msgstr ""

