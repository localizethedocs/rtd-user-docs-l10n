#: ../../../intro/starlight.rst:-1
msgid "Learn how to host Starlight documentation on Read the Docs."
msgstr ""

#: ../../../intro/starlight.rst:3
msgid "Deploying Starlight on Read the Docs"
msgstr ""

#: ../../../intro/starlight.rst:12
msgid ""
"`Starlight`_ is a documentation framework built on top of the `Astro`_ web "
"framework."
msgstr ""

#: ../../../intro/starlight.rst:14
msgid ""
"Minimal configuration is required to build an existing Starlight project on "
"Read the Docs."
msgstr ""

#: ../../../intro/starlight.rst:16
msgid ".readthedocs.yaml"
msgstr ""

#: ../../../intro/starlight.rst:16
msgid ""
" version: 2\n"
"\n"
" build:\n"
"     os: ubuntu-lts-latest\n"
"     tools:\n"
"         nodejs: \"latest\"\n"
"     jobs:\n"
"         install:\n"
"             - npm install\n"
"         build:\n"
"             html:\n"
"                 # The site was created by running\n"
"                 # `npm create astro@latest -- --template starlight`\n"
"                 # and following the official guide\n"
"                 # https://starlight.astro.build/getting-started/\n"
"                 - npm run build\n"
"                 - mkdir -p $READTHEDOCS_OUTPUT/\n"
"                 - mv dist $READTHEDOCS_OUTPUT/html"
msgstr ""

