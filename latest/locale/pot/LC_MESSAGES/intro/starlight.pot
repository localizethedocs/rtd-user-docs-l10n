#: ../../../intro/starlight.rst:50
msgid "Using the proper base path"
msgstr ""

#: ../../../intro/starlight.rst:52
msgid ""
"To ensure that your Starlight site works correctly on Read the Docs, you "
"need to set the ``site`` and ``base`` options in your Astro configuration:"
msgstr ""

#: ../../../intro/starlight.rst:55
msgid "astro.config.mjs"
msgstr ""

#: ../../../intro/starlight.rst:55
msgid ""
" import { defineConfig } from 'astro/config';\n"
" import starlight from '@astrojs/starlight';\n"
"\n"
" // https://astro.build/config\n"
" export default defineConfig({\n"
"     // Use the Read the Docs canonical URL so links and assets\n"
"     // resolve under the version path (e.g. `/en/latest/`)\n"
"     site: process.env.READTHEDOCS_CANONICAL_URL,\n"
"     base: process.env.READTHEDOCS_CANONICAL_URL\n"
"         ? new URL(process.env.READTHEDOCS_CANONICAL_URL).pathname\n"
"         : '/',\n"
"     integrations: [\n"
"         starlight({\n"
"             title: 'My Docs',\n"
"         }),\n"
"     ],\n"
" });"
msgstr ""

#: ../../../intro/starlight.rst:78
msgid ""
"Links starting with ``/`` in your content are not prefixed with the base "
"path. Use relative links (e.g. ``./guides/example/``) so they work under the "
"version path."
msgstr ""

